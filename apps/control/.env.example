# Appwrite — jede App nutzt ihre EIGENE Instanz (lokal: OrbStack)
# Zwei Keys (Konzept A2), beide server-only — NIE committen!
# Runtime-Key: sessions.write, users.read/write, rows.read/write, health.read
NUXT_APPWRITE_KEY=
# Migrations-Key: databases/tables/columns/indexes read+write — NUR für Migrations-
# Scripts (lokal/CI). Gehört NIE auf den laufenden App-Server (Prod).
NUXT_APPWRITE_MIGRATIONS_KEY=

NUXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost/v1
NUXT_PUBLIC_APPWRITE_PROJECT_ID=studio-1xsl
NUXT_PUBLIC_APPWRITE_DATABASE_ID=
# Storage-Bucket für Profilfotos (leer = Avatar-Upload-UI ausgeblendet)
NUXT_PUBLIC_APPWRITE_AVATARS_BUCKET=
# Storage-Bucket für GDPR-Pre-Delete-Snapshots (leer = Löschung ohne Snapshot)
NUXT_PUBLIC_APPWRITE_GDPR_BUCKET=

NUXT_PUBLIC_APP_URL=http://localhost:3004

# Betriebs-Alerts (L6): Health-Sweep mailt Statuswechsel (leer = aus)
NUXT_ALERT_EMAIL=

# Billing (Stripe, Test-Mode zum Start) — server-only. A6: die Community zahlt.
# Secret-Key aus dashboard.stripe.com → Entwickler → API-Schlüssel (sk_test_…);
# Webhook-Secret lokal via `stripe listen --forward-to localhost:3004/api/stripe/webhook`.
NUXT_STRIPE_SECRET_KEY=""
NUXT_STRIPE_WEBHOOK_SECRET=""

# Self-Service-Onboarding: Service-Secret (identisch mit NUXT_ONBOARDING_SERVICE_SECRET
# der Platform-App). LEER = die /api/control/onboarding/*-Routen antworten 404.
NUXT_CONTROL_ONBOARDING_SECRET=
# Pool-Appwrite-Projekt dieser Umgebung (leer = app.config-Default "pool").
NUXT_PUBLIC_CONTROL_POOL_PROJECT=

# ── Eigene Domains je Community (control-035, 2026-08-07) ────────────────────
# ploi-API-Token. Er darf ALLES auf allen Servern des Kontos (Sites anlegen,
# Deploys ausloesen, nginx tauschen) und gehoert deshalb NUR hierher, nie in
# eine App, die Kunden-Traffic bedient. LEER = das Merkmal laeuft, der
# Zertifikatsschritt bleibt aber ehrlich auf `pending_cert` stehen.
# Server + Site, an die Kundendomains als ploi-TENANTS gehaengt werden
# (Prod heute: Server `app-prod` = 118713, Site `platform.pukalani.app` = 391312).
# Kundendomains laufen als TENANTS ueber HTTP-01 — NIE ein Zertifikat auf einer
# SITE anfordern, das ueberschreibt das Kunden-Wildcard (CLAUDE.md, TLS-Falle).
NUXT_PLOI_TOKEN=
NUXT_PLOI_SERVER_ID=
NUXT_PLOI_SITE_ID=
# Trockenlauf: alle Zustandsuebergaenge laufen, ploi wird nicht angefasst und
# die HTTPS-Probe entfaellt. Nur fuer lokale Beweise. 1/true/yes/on = an.
NUXT_CUSTOM_DOMAIN_DRY_RUN=
# Wohin der Kunde zeigen soll. Beides hat einen Build-Default (49.13.211.173 /
# platform.pukalani.app) — hier nur setzen, wenn der Server umgezogen ist.
# FAIL-CLOSED: steht beides leer, zeigt keine Domain auf uns und keine wird aktiv.
NUXT_CUSTOM_DOMAIN_SERVER_IPS=
NUXT_CUSTOM_DOMAIN_CNAME_TARGET=
# Welche Resolver gefragt werden (kommagetrennt). Leer = Cloudflare + Google.
# NIE die des Betriebssystems: deren Negativ-Cache haelt eine frisch angelegte
# Zone minutenlang fuer nicht existent.
NUXT_CUSTOM_DOMAIN_DNS_SERVERS=

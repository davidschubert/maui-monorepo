# Marketing-Startseite (pukalani.app). Öffentlich + datensparsam — schreibt
# nichts. Appwrite-Config nur, damit die Core-/System-Layer booten.
# Zwei Keys (Konzept A2), beide server-only — NIE committen!
NUXT_APPWRITE_KEY=
NUXT_APPWRITE_MIGRATIONS_KEY=

NUXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost/v1
NUXT_PUBLIC_APPWRITE_PROJECT_ID=marketing
NUXT_PUBLIC_APPWRITE_DATABASE_ID=main
NUXT_PUBLIC_APPWRITE_AVATARS_BUCKET=
NUXT_PUBLIC_APPWRITE_GDPR_BUCKET=

NUXT_PUBLIC_APP_URL=http://localhost:3007
# Absolute URLs für hreflang/canonical (SEO)
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3007

# Ziel-Links der CTAs (useProductLinks). Leer/ungesetzt = die Prod-Hosts aus
# dem Skeleton in nuxt.config.ts (my.pukalani.app / demo.pukalani.app).
# NUXT_PUBLIC_MARKETING_START_URL=http://localhost:3004/register
# NUXT_PUBLIC_MARKETING_SIGN_IN_URL=http://localhost:3004/login
# NUXT_PUBLIC_MARKETING_DEMO_URL=http://localhost:3004

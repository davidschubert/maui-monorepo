# Hilfe-Site (Ziel-Host help.pukalani.app, noch nicht live — siehe
# site.manifest.ts). Öffentlich, read-only, ohne Konto: die Seite
# rendert nur Markdown aus content/ und spricht im Normalbetrieb NIE mit
# Appwrite (server/middleware/auth.ts macht ohne Session-Cookie keinen
# Roundtrip). Die Werte hier existieren nur, damit die Fundament-Layer
# booten — leer lassen ist in Ordnung.
NUXT_APPWRITE_KEY=
NUXT_APPWRITE_MIGRATIONS_KEY=

NUXT_PUBLIC_APPWRITE_ENDPOINT=
NUXT_PUBLIC_APPWRITE_PROJECT_ID=
NUXT_PUBLIC_APPWRITE_DATABASE_ID=

NUXT_PUBLIC_APP_URL=http://localhost:3008
# Absolute URLs für hreflang/canonical (SEO)
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3008

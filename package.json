{
  "name": "pukalani-monorepo",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:core": "pnpm --filter @pukalani/core dev",
    "dev:app": "pnpm --filter comments dev",
    "dev:docs": "pnpm --filter @pukalani/docs dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "changelog:draft": "node --env-file=apps/comments/.env packages/admin/scripts/changelog-draft.mjs",
    "migrate": "node --experimental-strip-types scripts/migrate.mjs",
    "create-site": "node --experimental-strip-types scripts/create-site.mjs",
    "control:jobs": "node --experimental-strip-types scripts/control-jobs.mjs",
    "entitlements:keygen": "node scripts/entitlements-keygen.mjs",
    "check:manifests": "node --experimental-strip-types scripts/check-manifests.mjs",
    "bilanz": "node --experimental-strip-types scripts/produkt-bilanz.mjs",
    "check:bilanz": "node --experimental-strip-types scripts/produkt-bilanz.mjs --check",
    "check:single-copy": "node scripts/check-single-copy.mjs",
    "check:doc-links": "node scripts/ops/verify-doc-links.mjs"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:",
    "eslint": "catalog:"
  }
}
